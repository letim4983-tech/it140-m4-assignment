
# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    PUT "Welcome to the higher/lower game, Bella!"

    # Ask for valid lower and upper bounds.
    PUT "Enter the lower bound:"
    GET lower_bound

    PUT "Enter the upper bound:"
    GET upper_bound

    WHILE lower_bound >= upper_bound
        PUT "The lower bound must be less than the upper bound."

        PUT "Enter the lower bound:"
        GET lower_bound

        PUT "Enter the upper bound:"
        GET upper_bound
    ENDWHILE

    # Choose a random whole number within the bounds.
    LET secret_number = RANDOM_INTEGER(lower_bound, upper_bound)

    # Ask the player to guess the number.
    PUT "Great, now guess a number between", lower_bound, "and", upper_bound
    GET guess

    # Keep asking until the correct number is guessed.
    WHILE guess != secret_number

        # Check if the guess is outside the allowed range.
        IF guess < lower_bound OR guess > upper_bound THEN
            PUT "Please enter a number between", lower_bound, "and", upper_bound

        ELSE
            # Check if the guess is too low or too high.
            IF guess < secret_number THEN
                PUT "Nope, too low."
            ELSE
                PUT "Nope, too high."
            ENDIF
        ENDIF

        PUT "Guess another number:"
        GET guess

    ENDWHILE

    # Display a message when the player guesses correctly.
    PUT "You got it!"

END hilow_game
