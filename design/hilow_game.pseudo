
# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode

START hilow_game

    # Get the player's number range.
    PUT "Welcome to the Higher/Lower Game!"
    PUT "Enter the lower bound:"
    GET lower_bound
    PUT "Enter the upper bound:"
    GET upper_bound

    # Repeat until the bounds are valid.
    WHILE lower_bound >= upper_bound
        PUT "The lower bound must be less than the upper bound."
        PUT "Enter the lower bound:"
        GET lower_bound
        PUT "Enter the upper bound:"
        GET upper_bound
    ENDWHILE

    # Generate the secret number.
    LET secret_number = RANDOM number between lower_bound and upper_bound

    # Continue until the player guesses correctly.
    LET correct_guess = FALSE

    WHILE correct_guess == FALSE

        PUT "Guess a number between the selected bounds:"
        GET guess

        # Check if the guess is within the range.
        IF guess < lower_bound OR guess > upper_bound
            PUT "Your guess must be within the selected range."

        ELSE
            # Compare the valid guess to the secret number.
            IF guess < secret_number
                PUT "Nope, too low."
            ELSE IF guess > secret_number
                PUT "Nope, too high."
            ELSE
                PUT "You got it!"
                LET correct_guess = TRUE
            ENDIF
        ENDIF

    ENDWHILE

END hilow_game
